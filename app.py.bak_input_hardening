def is_api_request() -> bool:
    return request.path.startswith("/api/")


def api_success(data=None, meta=None, status=200):
    response = {
        "success": True,
        "data": data if data is not None else {},
        "meta": meta or {},
    }
    return jsonify(response), status


def api_error(code: str, message: str, details=None, status=500):
    response = {
        "success": False,
        "error": {
            "code": code,
            "message": message,
            "details": details or {},
        }
    }
    return jsonify(response), status


@app.errorhandler(AirtableClientError)
def handle_airtable_client_error(error):
    if is_api_request():
        return api_error(
            code="AIRTABLE_OPERATION_FAILED",
            message="פעולת Airtable נכשלה",
            details={
                "operation": error.operation,
                "table": error.table_name,
                **(error.details or {}),
            },
            status=502,
        )
    raise error


@app.errorhandler(HTTPException)
def handle_http_exception(error):
    if is_api_request():
        return api_error(
            code=error.name.upper().replace(" ", "_"),
            message=error.description,
            details={"status_code": error.code},
            status=error.code,
        )
    return error


@app.errorhandler(Exception)
def handle_unexpected_exception(error):
    if is_api_request():
        return api_error(
            code="INTERNAL_SERVER_ERROR",
            message="שגיאה פנימית בשרת",
            details={"type": error.__class__.__name__},
            status=500,
        )
    raise error


def enrich_orders_with_customers(orders, customers):
    """Inject _שם לקוח and _טלפון into each order from customer lookup."""
    cust_map = {c['id']: c for c in customers}
    for o in orders:
        name = o.get('שם לקוח')
        phone = o.get('טלפון')
        if isinstance(name, list):
            name = name[0] if name else ''
        if isinstance(phone, list):
            phone = phone[0] if phone else ''
        if not name:
            cust_ids = o.get('לקוחות', [])
            if isinstance(cust_ids, list) and cust_ids:
                cust = cust_map.get(cust_ids[0])
                if cust:
                    n = cust.get('שם לקוח', '')
                    if isinstance(n, list): n = n[0] if n else ''
                    p = cust.get('טלפון', '')
                    if isinstance(p, list): p = p[0] if p else ''
                    name = name or n
                    phone = phone or p
        o['_שם לקוח'] = name or '—'
        o['_טלפון'] = phone or '—'
    return orders


