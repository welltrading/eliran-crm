class AirtableClientError(Exception):
    """Raised when an Airtable operation fails and the caller requests strict handling."""

    def __init__(self, operation: str, table_name: str, message: str, details: dict | None = None):
        super().__init__(message)
        self.operation = operation
        self.table_name = table_name
        self.message = message
        self.details = details or {}

