class AirtableClient:
    def __init__(self):
        self.api = Api(AIRTABLE_API_KEY)
        self.base = self.api.base(BASE_ID)
        self._tables = {}

    def table(self, name: str):
        if name not in self._tables:
            self._tables[name] = self.base.table(TABLES[name])
        return self._tables[name]

    def _formula_string(self, value) -> str:
        value = "" if value is None else str(value)
        value = value.replace("\\", "\\\\").replace("'", "\\'")
        return f"'{value}'"

    def _formula_equals(self, field_name: str, value) -> str:
        return f"{{{field_name}}}={self._formula_string(value)}"

    def _formula_find(self, needle, haystack_expr: str) -> str:
        return f"FIND({self._formula_string(needle)}, {haystack_expr})"

    def _formula_and(self, *parts: str) -> str | None:
        parts = [p for p in parts if p]
        if not parts:
            return None
        if len(parts) == 1:
            return parts[0]
        return f"AND({', '.join(parts)})"

    def _formula_or(self, *parts: str) -> str | None:
        parts = [p for p in parts if p]
        if not parts:
            return None
        if len(parts) == 1:
            return parts[0]
        return f"OR({', '.join(parts)})"

    # ── Generic CRUD ──────────────────────────────────────────────────────────

    def _handle_error(self, operation: str, table_name: str, error: Exception, default, raise_on_error: bool):
        print(f"[AirtableClient] {operation}({table_name}) error: {error}")
        traceback.print_exc()
        if raise_on_error:
            raise AirtableClientError(
                operation=operation,
                table_name=table_name,
                message="Airtable operation failed",
                details={"original_error": str(error)}
            ) from error
        return default

    def get_all(self, table_name: str, formula: str = None, sort=None, fields=None, raise_on_error: bool = False) -> list:
        """Return all records from a table."""
        try:
            kwargs = {}
            if formula:
                kwargs["formula"] = formula
            if sort:
                kwargs["sort"] = sort
            if fields:
                kwargs["fields"] = fields
            records = self.table(table_name).all(**kwargs)
            return [{"id": r["id"], **r["fields"]} for r in records]
        except Exception as e:
            return self._handle_error("get_all", table_name, e, [], raise_on_error)

    def get_one(self, table_name: str, record_id: str, raise_on_error: bool = False) -> dict | None:
        """Return a single record by ID."""
        try:
            r = self.table(table_name).get(record_id)
            return {"id": r["id"], **r["fields"]}
        except Exception as e:
            return self._handle_error("get_one", table_name, e, None, raise_on_error)

    def create(self, table_name: str, fields: dict, raise_on_error: bool = False) -> dict | None:
        """Create a new record."""
        try:
            r = self.table(table_name).create(fields, typecast=True)
            return {"id": r["id"], **r["fields"]}
        except Exception as e:
            return self._handle_error("create", table_name, e, None, raise_on_error)

    def update(self, table_name: str, record_id: str, fields: dict, raise_on_error: bool = False) -> dict | None:
        """Update an existing record."""
        try:
            r = self.table(table_name).update(record_id, fields)
            return {"id": r["id"], **r["fields"]}
        except Exception as e:
            return self._handle_error("update", table_name, e, None, raise_on_error)

    def delete(self, table_name: str, record_id: str, raise_on_error: bool = False) -> bool:
        """Delete a record (use sparingly – prefer soft-delete)."""
        try:
            self.table(table_name).delete(record_id)
            return True
        except Exception as e:
            return self._handle_error("delete", table_name, e, False, raise_on_error)

    # ── Domain helpers ────────────────────────────────────────────────────────

    def get_customers(self, search: str = None, raise_on_error: bool = False) -> list:
        formula = None
        if search:
            formula = self._formula_or(
                self._formula_find(search, "{שם לקוח}"),
                self._formula_find(search, "{טלפון}")
            )
        fields = [
            "שם לקוח",
            "טלפון", 
            "אימייל",
            "כתובת",
            "הערות",
        ]
        return self.get_all("customers", formula=formula, fields=fields, sort=["שם לקוח"], raise_on_error=raise_on_error)

    def get_orders(self, status: str = None, customer_id: str = None, raise_on_error: bool = False) -> list:
        formula = self._formula_and(
            self._formula_equals("סטטוס", status) if status else None,
            self._formula_find(customer_id, "ARRAYJOIN({לקוחות})") if customer_id else None,
        )
        fields = [
            "מספר הזמנה",
            "שם לקוח",
            "טלפון",
            "סטטוס",
            "שם מוצר",
            "דגם (from שם מוצר)",
            "כמות",
            "מחיר בשקלים",
            "תאריך יצירה",
            "לקוחות",
        ]
        return self.get_all("orders", formula=formula, fields=fields, sort=["-תאריך יצירה"], raise_on_error=raise_on_error)

    def get_inventory(self, raise_on_error: bool = False) -> list:
        fields = [
            "מוצר",
            "מיקום",
            "כמות מחושבת",
            "מקט (from מוצר)",
            "מפתח מוצר-מיקום חדש",
            "שם המוצר",
            "תנועות מלאי",
            "RECORD_ID",
        ]
        return self.get_all("inventory_by_location", fields=fields, sort=["מיקום"], raise_on_error=raise_on_error)

    def get_installers(self, raise_on_error: bool = False) -> list:
        return self.get_all("installers", sort=["שם פרטי"], raise_on_error=raise_on_error)

    def get_tasks(self, status: str = None, raise_on_error: bool = False) -> list:
        formula = self._formula_equals("סטטוס", status) if status else None
        return self.get_all("tasks", formula=formula, raise_on_error=raise_on_error)

    def get_quotes(self, status: str = None, raise_on_error: bool = False) -> list:
        formula = self._formula_equals("סטטוס", status) if status else None
        fields = [
            "Name",
            "שם לקוח",
            "טלפון",
            "כתובת",
            "סטטוס",
            "מוצרים",
            "דגם (from מוצרים)",
            "כמות",
            "מחיר בשקלים",
            "מחיר כולל",
            "סטנדרטי/ייצור אישי",
            "תאריך יצירה",
        ]
        return self.get_all("quotes", formula=formula, fields=fields, sort=["-Name"], raise_on_error=raise_on_error)

    def get_products(self, raise_on_error: bool = False) -> list:
        return self.get_all("products", sort=["דגם בסיס", "מידה"], fields=[
            "שם מוצר מלא", "דגם", "דגם בסיס", "מידה", "גובה",
            "סוג זכוכית", "גוון פרזול", "מקט", "תיאור המוצר", "תמונה"
        ], raise_on_error=raise_on_error)

    def create_product(self, fields: dict, raise_on_error: bool = False) -> dict | None:
        return self.create("products", fields, raise_on_error=raise_on_error)

    def get_product(self, record_id: str, raise_on_error: bool = False) -> dict | None:
        return self.get_one("products", record_id, raise_on_error=raise_on_error)

    def get_order_lines(self, order_id: str, raise_on_error: bool = False) -> list:
        formula = self._formula_find(order_id, "ARRAYJOIN({הזמנה})")
        return self.get_all("order_lines", formula=formula, raise_on_error=raise_on_error)


# ── Singleton ─────────────────────────────────────────────────────────────────
_client: AirtableClient | None = None


def get_client() -> AirtableClient:
    global _client
    if _client is None:
        _client = AirtableClient()
    return _client
